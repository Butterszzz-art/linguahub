// LinguaHub Prisma schema
// Learn more about Prisma at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via pgbouncer) — used at runtime by the app/serverless
  // functions, where many short-lived connections need to share a pool.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only for running migrations, which
  // need a session-level connection a pooler in transaction mode can't give.
  directUrl = env("DIRECT_URL")
}

model Classroom {
  id            String         @id @default(cuid())
  language      String
  level         String?
  units         Unit[]
  exams         Exam[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  streakCount   Int            @default(0)
  lastStudiedAt DateTime?
}

model Unit {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  title       String
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id           String   @id @default(cuid())
  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id])
  title        String
  order        Int
  contentHtml  String   @default("")
  status       String   @default("not_started")
  timeSpentSec Int      @default(0)

  /// AI-generated enrichment (see lib/contentEnrichment.ts) — a plain-language
  /// synopsis, key vocab, and key grammar points distilled from contentHtml.
  /// All null until "Enrich with AI" is run; regenerating overwrites them.
  summary          String?
  keyVocabulary    String? // JSON array of {term, translation}
  keyGrammarPoints String? // JSON array of short strings
  enrichedAt       DateTime?

  conversations Conversation[]
}

model Exam {
  id          String        @id @default(cuid())
  classroomId String
  classroom   Classroom     @relation(fields: [classroomId], references: [id])
  title       String
  questions   Question[]
  attempts    ExamAttempt[]
}

model Question {
  id            String  @id @default(cuid())
  examId        String
  exam          Exam    @relation(fields: [examId], references: [id])
  type          String
  prompt        String
  options       String?
  correctAnswer String?
  order         Int
}

model ExamAttempt {
  id      String   @id @default(cuid())
  examId  String
  exam    Exam     @relation(fields: [examId], references: [id])
  answers String
  score   Int?
  takenAt DateTime @default(now())
}

/// A single practice-conversation session with the AI partner, scoped to one
/// classroom so it can be calibrated to that classroom's language/level.
/// Optionally scoped to one lesson too — "practice this lesson" starts a
/// conversation grounded in that lesson's specific vocab/grammar rather than
/// the classroom's material as a whole.
model Conversation {
  id          String                 @id @default(cuid())
  classroomId String
  classroom   Classroom              @relation(fields: [classroomId], references: [id])
  lessonId    String?
  lesson      Lesson?                @relation(fields: [lessonId], references: [id])
  title       String? // optional scenario label, e.g. "Ordering at a restaurant"; null = free chat
  messages    ConversationMessage[]
  createdAt   DateTime               @default(now())
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
}
