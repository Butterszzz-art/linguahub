# Copy this file to .env and fill in real values.
#
# Local dev: point both at the same local Postgres instance (or a free
# branch on your hosted provider) — a single URL works fine for local work
# since there's no serverless connection pooling concern.
#
# Production (Vercel): DATABASE_URL should be the *pooled* connection string
# (via pgbouncer — usually labeled "recommended for most uses"/"pooled" in
# your provider's dashboard). DIRECT_URL should be the *unpooled* one — it's
# only used when running migrations, which need a direct session connection.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
