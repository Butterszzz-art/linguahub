# Copy this file to .env and fill in real values.
#
# Local dev: point both at the same local Postgres instance (or a free
# branch on your hosted provider) — a single URL works fine for local work
# since there's no serverless connection pooling concern.
#
# Production (Vercel): DATABASE_URL should be the *pooled* connection string
# (via pgbouncer — usually labeled "recommended for most uses"/"pooled" in
# your provider's dashboard). DIRECT_URL should be the *unpooled* one — it's
# only used when running migrations, which need a direct session connection.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Conversation practice + lesson enrichment use OpenRouter (openrouter.ai)
# via lib/openrouter.ts. Get a key at https://openrouter.ai/keys and paste it
# below — do NOT commit a real key (this file is the *.example template;
# your actual key belongs in .env, which is gitignored).
CONVERSATION_API_KEY=""
# Optional overrides — defaults to OpenRouter's endpoint and a free-tier
# model (meta-llama/llama-3.3-70b-instruct:free) if left unset.
# CONVERSATION_API_URL="https://openrouter.ai/api/v1/chat/completions"
# CONVERSATION_API_MODEL="meta-llama/llama-3.3-70b-instruct:free"
